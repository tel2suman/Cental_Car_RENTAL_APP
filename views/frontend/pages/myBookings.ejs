<%- include('../layouts/header.ejs') %>

    <%- include('../layouts/topbar.ejs') %>

        <!-- Navbar & Hero Start -->
        <div class="container-fluid nav-bar sticky-top px-0 px-lg-4 py-2 py-lg-0">
            <div class="container">
                <nav class="navbar navbar-expand-lg navbar-light">
                    <a href="/" class="navbar-brand p-0">
                        <h1 class="display-6 text-primary"><i class="fas fa-car-alt me-3"></i></i>Cental</h1>
                    </a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target="#navbarCollapse">
                        <span class="fa fa-bars"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="navbarCollapse">
                        <div class="navbar-nav mx-auto py-0">
                            <a href="/dashboard" class="nav-item nav-link">Home</a>
                            <a href="/about" class="nav-item nav-link">About</a>
                            <a href="/available-cars" class="nav-item nav-link">Vehicle</a>
                            <a href="/my-bookings" class="nav-item nav-link active">My Bookings</a>
                            <a href="/contact" class="nav-item nav-link">Contact</a>
                        </div>
                        <div class="dropdown text-end"> <a href="#"
                                class="d-block link-body-emphasis text-decoration-none dropdown-toggle badge-pill"
                                data-bs-toggle="dropdown" aria-expanded="false"> <img src="<%= user?.profileImage %>"
                                    alt="mdo" width="32" height="32" class="rounded-circle mr-3"> <strong class="mx-1">
                                    <%= user?.name %>
                                </strong></a>
                            <ul class="dropdown-menu w-100 text-small">
                                <li><a class="dropdown-item" href="/profile">Profile</a></li>
                                <li>
                                    <hr class="dropdown-divider">
                                </li>
                                <li><a class="dropdown-item" href="/cancelled-bookings">Cancelled Bookings</a></li>
                                <li>
                                    <hr class="dropdown-divider">
                                </li>
                                <li><a class="dropdown-item" href="/logout">Sign out</a></li>
                            </ul>
                        </div>
                    </div>
                </nav>
            </div>
        </div>
        <!-- Navbar & Hero End -->

        <!-- Header Start -->
        <div class="container-fluid bg-breadcrumb mb-5">
            <div class="container text-center py-5" style="max-width: 900px;">
                <h4 class="text-white display-4 mb-4 wow fadeInDown" data-wow-delay="0.1s">All Bookings</h4>
                <ol class="breadcrumb d-flex justify-content-center mb-0 wow fadeInDown" data-wow-delay="0.3s">
                    <li class="breadcrumb-item"><a href="/">Home</a></li>
                    <li class="breadcrumb-item"><a href="#">Pages</a></li>
                    <li class="breadcrumb-item active text-primary">Booking</li>
                </ol>
            </div>
        </div>
        <!-- Header End -->

        <div class="container-fluid py-5">

            <!-- BOOKING CARD -->

            <div class="card booking-card">

                <!-- HEADER -->

                <div class="booking-header d-flex justify-content-between align-items-center flex-wrap">

                    <h3 class="text-white">

                        Booking History

                    </h3>

                    <span class="badge bg-light text-dark px-4 py-2 rounded-pill fw-semibold">

                        Total:
                        <%= bookings.length %>

                    </span>

                </div>

                <!-- BODY -->

                <div class="card-body p-0">

                    <div class="table-responsive">

                        <table class="table align-middle mb-0">

                            <thead>

                                <tr>

                                    <th>#</th>

                                    <th>Car</th>

                                    <th>Image</th>

                                    <th>Pickup</th>

                                    <th>Return</th>

                                    <th>Duration</th>

                                    <th>Amount</th>

                                    <th>Booking</th>

                                    <th>Payment</th>

                                    <th>Payment ID</th>

                                    <th>Action</th>

                                </tr>

                            </thead>

                            <tbody>

                                <% if(bookings.length> 0) { %>

                                    <% bookings.forEach((booking, index)=> { %>

                                        <tr>

                                            <!-- SL -->

                                            <td class="fw-bold text-muted">

                                                #<%= index + 1 %>

                                            </td>

                                            <!-- CAR -->

                                            <td>

                                                <div class="car-name">

                                                    <%= booking.carId?.brand %>

                                                </div>

                                                <small class="text-muted">

                                                    <%= booking.carId?.model %>

                                                </small>

                                            </td>

                                            <!-- IMAGE -->

                                            <td>

                                                <img src="<%= booking.carId?.image %>" class="booking-img">

                                            </td>

                                            <!-- PICKUP -->

                                            <td>

                                                <span class="badge bg-light text-dark custom-badge">

                                                    <%= booking.pickupDate.toDateString() %>

                                                </span>

                                            </td>

                                            <!-- RETURN -->

                                            <td>

                                                <span class="badge bg-light text-dark custom-badge">

                                                    <%= booking.returnDate.toDateString() %>

                                                </span>

                                            </td>

                                            <!-- DAYS -->

                                            <td>

                                                <span class="badge bg-primary custom-badge">

                                                    <%= booking.totalDays %> Days

                                                </span>

                                            </td>

                                            <!-- AMOUNT -->

                                            <td>

                                                <span class="amount">

                                                    ₹<%= booking.totalAmount %>

                                                </span>

                                            </td>

                                            <!-- BOOKING STATUS -->

                                            <td>

                                                <% if(booking.bookingStatus==="Approved" ) { %>

                                                    <span class="badge bg-success custom-badge">

                                                        Approved

                                                    </span>

                                                    <% } else if( booking.bookingStatus==="Pending" ) { %>

                                                        <span class="badge bg-warning text-dark custom-badge">

                                                            Pending

                                                        </span>

                                                        <% } else if( booking.bookingStatus==="Cancelled" ) { %>

                                                            <span class="badge bg-danger custom-badge">

                                                                Cancelled

                                                            </span>

                                                            <% } else if( booking.bookingStatus==="Rejected" ) { %>

                                                                <span class="badge bg-danger custom-badge">

                                                                    Rejected

                                                                </span>

                                                                <% } else { %>

                                                                    <span class="badge bg-info custom-badge">

                                                                        Completed

                                                                    </span>

                                                                    <% } %>

                                            </td>

                                            <!-- PAYMENT STATUS -->

                                            <td>

                                                <% if(booking.paymentStatus==="Success" ) { %>

                                                    <span class="badge bg-success custom-badge">

                                                        Success

                                                    </span>

                                                    <% } else if( booking.paymentStatus==="Pending" ) { %>

                                                        <span class="badge bg-warning text-dark custom-badge">

                                                            Pending

                                                        </span>

                                                        <% } else if( booking.paymentStatus==="Refunded" ) { %>

                                                            <span class="badge bg-info custom-badge">

                                                                Refunded

                                                            </span>

                                                            <% } else { %>

                                                                <span class="badge bg-danger custom-badge">

                                                                    Failed

                                                                </span>

                                                                <% } %>

                                            </td>

                                            <!-- PAYMENT ID -->

                                            <td>

                                                <% if(booking.paymentId) { %>

                                                    <small class="fw-bold text-success">

                                                        <%= booking.paymentId %>

                                                    </small>

                                                    <% } else { %>

                                                        <span class="text-muted">

                                                            N/A

                                                        </span>

                                                        <% } %>

                                            </td>

                                            <!-- ACTION -->

                                            <td>

                                                <% if( booking.bookingStatus !=="Cancelled" && booking.bookingStatus
                                                    !=="Rejected" && booking.bookingStatus !=="Completed" ) { %>

                                                    <a href="/cancel-booking/<%= booking._id %>" class="btn btn-cancel" onclick="
                                                            return confirm(
                                                                'Are you sure you want to cancel this booking?'
                                                            )
                                                        ">

                                                        <i class="fas fa-times-circle me-1"></i>

                                                        Cancel Booking

                                                    </a>

                                                    <% } else { %>

                                                        <span class="text-muted">

                                                            No Action

                                                        </span>

                                                        <% } %>

                                            </td>

                                        </tr>

                                        <% }) %>

                                            <% } else { %>

                                                <!-- EMPTY STATE -->

                                                <tr>

                                                    <td colspan="11">

                                                        <div class="empty-state text-center py-5">

                                                            <img src="https://cdn-icons-png.flaticon.com/512/4076/4076549.png">

                                                            <h4>

                                                                No Bookings Found

                                                            </h4>

                                                            <p class="text-muted">

                                                                Your bookings will appear here once you reserve a car.

                                                            </p>

                                                        </div>

                                                    </td>

                                                </tr>

                                                <% } %>

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>

        </div>

        <%- include('../layouts/footer.ejs') %>