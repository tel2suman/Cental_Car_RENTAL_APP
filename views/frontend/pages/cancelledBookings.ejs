<%- include('../layouts/header.ejs') %>

    <%- include('../layouts/topbar.ejs') %>

        <!-- Navbar & Hero Start -->
        <div class="container-fluid nav-bar sticky-top px-0 px-lg-4 py-2 py-lg-0">
            <div class="container">
                <nav class="navbar navbar-expand-lg navbar-light">
                    <a href="/" class="navbar-brand p-0">
                        <h1 class="display-6 text-primary"><i class="fas fa-car-alt me-3"></i></i>Cental</h1>
                    </a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target="#navbarCollapse">
                        <span class="fa fa-bars"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="navbarCollapse">
                        <div class="navbar-nav mx-auto py-0">
                            <a href="/dashboard" class="nav-item nav-link">Home</a>
                            <a href="/about" class="nav-item nav-link">About</a>
                            <a href="/available-cars" class="nav-item nav-link">Vehicle</a>
                            <a href="/my-bookings" class="nav-item nav-link active">My Bookings</a>
                            <a href="/contact" class="nav-item nav-link">Contact</a>
                        </div>
                        <div class="dropdown text-end"> <a href="#"
                                class="d-block link-body-emphasis text-decoration-none dropdown-toggle badge-pill"
                                data-bs-toggle="dropdown" aria-expanded="false"> <img src="<%= user?.profileImage %>"
                                    alt="mdo" width="32" height="32" class="rounded-circle mr-3"> <strong class="mx-1">
                                    <%= user?.name %>
                                </strong></a>
                            <ul class="dropdown-menu w-100 text-small">
                                <li><a class="dropdown-item" href="/profile">Profile</a></li>
                                <li>
                                    <hr class="dropdown-divider">
                                </li>
                                <li><a class="dropdown-item" href="/cancelled-bookings">Cancelled Bookings</a></li>
                                <li>
                                    <hr class="dropdown-divider">
                                </li>
                                <li><a class="dropdown-item" href="/logout">Sign out</a></li>
                            </ul>
                        </div>
                    </div>
                </nav>
            </div>
        </div>
        <!-- Navbar & Hero End -->

        <!-- Header Start -->
        <div class="container-fluid bg-breadcrumb mb-5">
            <div class="container text-center py-5" style="max-width: 900px;">
                <h4 class="text-white display-4 mb-4 wow fadeInDown" data-wow-delay="0.1s">Cancelled Bookings</h4>
                <ol class="breadcrumb d-flex justify-content-center mb-0 wow fadeInDown" data-wow-delay="0.3s">
                    <li class="breadcrumb-item"><a href="/">Home</a></li>
                    <li class="breadcrumb-item"><a href="#">Pages</a></li>
                    <li class="breadcrumb-item active text-primary">Cancelled Bookings</li>
                </ol>
            </div>
        </div>
        <!-- Header End -->

        <div class="container py-5">

            <!-- TITLE -->

            <div class="text-center mb-5">

                <h1 class="section-title">

                    <i class="fas fa-ban text-danger me-2"></i>

                    Cancelled Bookings

                </h1>

                <p class="section-subtitle mt-3">

                    Explore all your cancelled rental reservations in one place

                </p>

            </div>

            <div class="row g-4">

                <% if(bookings.length> 0) { %>

                    <% bookings.forEach((booking, index)=> { %>

                        <div class="col-xl-4 col-lg-6">

                            <!-- CARD -->

                            <div class="card cancel-card h-100">

                                <!-- IMAGE -->

                                <div class="image-wrapper">

                                    <img src="<%= booking.carId.image %>" class="cancel-img" alt="Car Image">

                                    <div class="cancel-overlay"></div>

                                    <!-- BADGE -->

                                    <div class="top-badge">

                                        Cancelled #
                                        <%= index + 1 %>

                                    </div>

                                    <!-- TITLE -->

                                    <h2 class="car-title">

                                        <%= booking.carId.brand %>

                                            <%= booking.carId.model %>

                                    </h2>

                                </div>

                                <!-- BODY -->

                                <div class="card-body">

                                    <!-- PRICE -->

                                    <div class="price-box text-center">

                                        <div class="price-label">

                                            Total Amount

                                        </div>

                                        <div class="price-amount">

                                            ₹<%= booking.totalAmount %>

                                        </div>

                                    </div>

                                    <!-- DETAILS -->

                                    <div class="details-box">

                                        <div class="details-label">

                                            <i class="fas fa-calendar-alt text-danger me-2"></i>

                                            Pickup Date

                                        </div>

                                        <div class="details-value">

                                            <%= booking.pickupDate.toDateString() %>

                                        </div>

                                    </div>

                                    <div class="details-box">

                                        <div class="details-label">

                                            <i class="fas fa-calendar-check text-primary me-2"></i>

                                            Return Date

                                        </div>

                                        <div class="details-value">

                                            <%= booking.returnDate.toDateString() %>

                                        </div>

                                    </div>

                                    <div class="details-box">

                                        <div class="details-label">

                                            <i class="fas fa-clock text-warning me-2"></i>

                                            Duration

                                        </div>

                                        <div class="details-value">

                                            <%= booking.totalDays %> Days

                                        </div>

                                    </div>

                                    <% if(booking.paymentId) { %>

                                        <div class="details-box">

                                            <div class="details-label">

                                                <i class="fas fa-credit-card text-info me-2"></i>

                                                Payment ID

                                            </div>

                                            <div class="details-value text-primary">

                                                <%= booking.paymentId %>

                                            </div>

                                        </div>

                                        <% } %>

                                            <div class="details-box">

                                                <div class="details-label">

                                                    <i class="fas fa-ban text-danger me-2"></i>

                                                    Cancelled On

                                                </div>

                                                <div class="details-value">

                                                    <%= booking.updatedAt.toDateString() %>

                                                </div>

                                            </div>

                                            <!-- STATUS -->

                                            <div class="d-flex justify-content-between gap-2 mt-4">

                                                <span class="badge bg-danger status-badge w-100 py-3">

                                                    <i class="fas fa-times-circle me-2"></i>

                                                    <%= booking.bookingStatus %>

                                                </span>

                                                <span class="badge bg-warning text-dark status-badge w-100 py-3">

                                                    <i class="fas fa-wallet me-2"></i>

                                                    <%= booking.paymentStatus %>

                                                </span>

                                            </div>

                                </div>

                                <!-- FOOTER -->

                                <div class="card-footer border-0 bg-white p-4 pt-0">

                                    <button class="cancelled-btn">

                                        <i class="fas fa-ban me-2"></i>

                                        Booking Cancelled

                                    </button>

                                </div>

                            </div>

                        </div>

                        <% }) %>

                            <% } else { %>

                                <!-- EMPTY -->

                                <div class="col-12">

                                    <div class="empty-state text-center">

                                        <img src="https://cdn-icons-png.flaticon.com/512/7486/7486740.png">

                                        <h2>

                                            No Cancelled Bookings Found

                                        </h2>

                                        <p class="text-muted mt-3 mb-0">

                                            Cancelled bookings will appear here once you cancel any reservation.

                                        </p>

                                    </div>

                                </div>

                                <% } %>

            </div>

        </div>


    <%- include('../layouts/footer.ejs') %>