<%- include('../layouts/header.ejs') %>

    <body id="page-top">

        <!-- Page Wrapper -->
        <div id="wrapper">

            <!-- Sidebar -->
            <%- include('../layouts/sidebar.ejs') %>
                <!-- End of Sidebar -->

                <!-- Content Wrapper -->
                <div id="content-wrapper" class="d-flex flex-column">

                    <!-- Main Content -->
                    <div id="content">

                        <!-- Topbar -->
                        <%- include('../layouts/topbar.ejs') %>
                            <!-- End of Topbar -->

                            <!-- Begin Page Content -->
                            <div class="container-fluid">


                                <!-- Content Row -->

                                <!-- Content Row -->
                                <div class="row">

                                    <!-- CAR IMAGE -->
                                    <div class="col-md-6">

                                        <div class="card shadow">

                                            <img src="<%= data.image %>" alt="Car Image" class="img-fluid rounded" style="height: 400px; object-fit: cover;">

                                        </div>

                                    </div>

                                    <!-- CAR DETAILS -->
                                    <div class="col-md-6">

                                        <div class="card shadow">

                                            <div class="card-body">

                                                <h2 class="mb-4">
                                                    <%= data.brand %>
                                                        <%= data.model %>
                                                </h2>

                                                <hr>

                                                <div class="mb-3">

                                                    <strong>Car Type :</strong>

                                                    <span>
                                                        <%= data.type %>
                                                    </span>

                                                </div>

                                                <div class="mb-3">

                                                    <strong>Fuel Type :</strong>

                                                    <span>
                                                        <%= data.fuelType %>
                                                    </span>

                                                </div>

                                                <div class="mb-3">

                                                    <strong>Transmission :</strong>

                                                    <span>
                                                        <%= data.transmission %>
                                                    </span>

                                                </div>

                                                <div class="mb-3">

                                                    <strong>Location :</strong>

                                                    <span>
                                                        <%= data.location %>
                                                    </span>

                                                </div>

                                                <div class="mb-3">

                                                    <strong>Price Per Day :</strong>

                                                    <span class="text-success font-weight-bold">
                                                        ₹<%= data.pricePerDay %>
                                                    </span>

                                                </div>

                                                <div class="mb-4">

                                                    <strong>Status :</strong>

                                                    <% if(data.availability) { %>

                                                        <span class="badge badge-success">
                                                            Available
                                                        </span>

                                                        <% } else { %>

                                                            <span class="badge badge-danger">
                                                                Not Available
                                                            </span>

                                                            <% } %>

                                                </div>

                                                <!-- BUTTONS -->
                                                <div class="mt-4">

                                                    <% if(data && data.role==="admin" ) { %>

                                                        <a href="/edit-car/<%= data._id %>" class="btn btn-warning">
                                                            Edit Car
                                                        </a>

                                                        <a href="/delete-car/<%= data._id %>" class="btn btn-danger"
                                                            onclick="return confirm('Delete this car?')">
                                                            Delete
                                                        </a>

                                                        <% } else { %>

                                                            <% if(data.availability) { %>

                                                                <!-- <a href="/book-car/<%= data._id %>" class="btn btn-primary">
                                                                    Book Now
                                                                </a> -->

                                                                <% } %>

                                                                    <% } %>

                                                                        <a href="/manage-cars" class="btn btn-secondary btn-lg">
                                                                            Back
                                                                        </a>

                                                </div>

                                            </div>

                                        </div>

                                    </div>
                                    </div>
                                </div>
                    <!-- End of Main Content -->

                    <!-- Footer -->
                    <footer class="sticky-footer bg-white">
                        <div class="container my-auto">
                            <div class="copyright text-center my-auto">
                                <span>Copyright &copy; Your Website 2020</span>
                            </div>
                        </div>
                    </footer>
                    <!-- End of Footer -->

                </div>
                <!-- End of Content Wrapper -->

        </div>
        <!-- End of Page Wrapper -->

        <!-- Scroll to Top Button-->
        <a class="scroll-to-top rounded" href="#page-top">
            <i class="fas fa-angle-up"></i>
        </a>



        <%- include('../layouts/footer.ejs') %>