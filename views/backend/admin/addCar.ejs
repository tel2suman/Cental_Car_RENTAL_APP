<%- include('../layouts/header.ejs') %>

    <body id="page-top">

        <!-- Page Wrapper -->
        <div id="wrapper">

            <!-- Sidebar -->
            <%- include('../layouts/sidebar.ejs') %>
                <!-- End of Sidebar -->

                <!-- Content Wrapper -->
                <div id="content-wrapper" class="d-flex flex-column">

                    <!-- Main Content -->
                    <div id="content">

                        <!-- Topbar -->
                        <%- include('../layouts/topbar.ejs') %>
                            <!-- End of Topbar -->

                            <!-- Begin Page Content -->
                            <div class="container-fluid">

                                <!-- Page Heading -->
                                <div class="d-sm-flex align-items-center justify-content-between mb-4">
                                    <h1 class="h3 mb-0 text-gray-800">Add New Car</h1>
                                </div>

                                <!-- Content Row -->

                                <!-- Content Row -->
                                <div class="row">

                                    <div class="col-lg-12 mb-4">

                                        <!-- Illustrations -->
                                        <div class="card shadow mb-4">
                                            <div class="card-header py-3">
                                                <h6 class="m-0 font-weight-bold text-primary">Add Car</h6>
                                            </div>
                                            <div class="card-body">
                                                <%- include('../layouts/flash.ejs') %>

                                                    <form method="post" action="/add-car" enctype="multipart/form-data">

                                                        <!-- Brand -->
                                                        <div class="form-group mb-3">
                                                            <label>Brand</label>

                                                            <input type="text" name="brand" class="form-control"
                                                                placeholder="Brand" required>
                                                        </div>

                                                        <!-- NAME -->
                                                        <div class="form-group mb-3">
                                                            <label>Model</label>

                                                            <input type="text" name="model" class="form-control"
                                                                placeholder="Model" required>
                                                        </div>

                                                        <!-- PHONE -->
                                                        <div class="form-group">
                                                            <label>Type</label>
                                                            <div class="col-sm-12 mb-4 mb-sm-0 px-0">
                                                                <select class="form-control" name="type" required>
                                                                    <option value="SUV" selected>SUV</option>
                                                                    <option value="Sedan">Sedan</option>
                                                                    <option value="Hatchback">Hatchback</option>
                                                                    <option value="Luxury">Luxury</option>
                                                                    <option value="Electric">Electric</option>
                                                                </select>
                                                            </div>
                                                        </div>

                                                        <!-- PHONE -->
                                                        <div class="form-group">
                                                            <label>Seating Capacity</label>
                                                            <div class="col-sm-12 mb-4 mb-sm-0 px-0">
                                                                <select class="form-control" name="seatingCapacity" required>
                                                                    <option value="4STR">4 Seater</option>
                                                                    <option value="7STR"selected>7 Seater</option>
                                                                    <option value="9STR">9 Seater</option>
                                                                </select>
                                                            </div>
                                                        </div>

                                                        <!-- NAME -->
                                                        <div class="form-group mb-3">
                                                            <label>Registration Year</label>
                                                            <input type="number" name="registrationYear" class="form-control" placeholder="Registration Year" required>
                                                        </div>


                                                        <!-- DRIVING LICENSE -->
                                                        <div class="form-group">
                                                            <label>Fuel Type</label>
                                                            <div class="col-sm-12 mb-4 mb-sm-0 px-0">
                                                                <select class="form-control" name="fuelType" required>
                                                                    <option value="Petrol" selected>Petrol</option>
                                                                    <option value="Diesel">Diesel</option>
                                                                    <option value="Electric">Electric</option>
                                                                    <option value="Hybrid">Hybrid</option>
                                                                </select>
                                                            </div>
                                                        </div>

                                                        <!-- ADDRESS -->
                                                        <div class="form-group">
                                                            <label>Transmission</label>
                                                            <div class="col-sm-12 mb-4 mb-sm-0 px-0">
                                                                <select class="form-control" name="transmission" required>
                                                                    <option value="Manual" selected>Manual</option>
                                                                    <option value="Automatic">Automatic</option>
                                                                </select>
                                                            </div>
                                                        </div>

                                                        <!-- NAME -->
                                                        <div class="form-group mb-3">
                                                            <label>Price Per Day</label>

                                                            <input type="number" name="pricePerDay" class="form-control" placeholder="Price Per Day" required>
                                                        </div>

                                                        <div class="form-group mb-3">
                                                            <label>Location</label>

                                                            <input type="text" name="location" class="form-control" placeholder="Location" required>
                                                        </div>

                                                        <div class="form-group">
                                                            <label>Avability</label>
                                                            <div class="col-sm-12 mb-4 mb-sm-0 px-0">
                                                                <select class="form-control" name="availability" required>
                                                                    <option value="true" selected>Yes</option>
                                                                    <option value="false">No</option>
                                                                </select>
                                                            </div>
                                                        </div>

                                                        <div class="form-group mb-3">
                                                            <label>Car Image</label>

                                                            <input type="file" name="image" class="form-control" required>
                                                        </div>

                                                        <!-- BUTTON -->
                                                        <button type="submit" class="btn btn-primary btn-lg">
                                                            Add a Car
                                                        </button>

                                                        <a href="/profile" class="btn btn-secondary btn-lg">
                                                            Cancel
                                                        </a>

                                                    </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!-- /.container-fluid -->
                    </div>
                    <!-- End of Main Content -->

                    <!-- Footer -->
                    <footer class="sticky-footer bg-white">
                        <div class="container my-auto">
                            <div class="copyright text-center my-auto">
                                <span>Copyright &copy; Your Website 2020</span>
                            </div>
                        </div>
                    </footer>
                    <!-- End of Footer -->

                </div>
                <!-- End of Content Wrapper -->

        </div>
        <!-- End of Page Wrapper -->

        <!-- Scroll to Top Button-->
        <a class="scroll-to-top rounded" href="#page-top">
            <i class="fas fa-angle-up"></i>
        </a>



        <%- include('../layouts/footer.ejs') %>