<%- include('../layouts/header.ejs') %>

    <body id="page-top">

        <!-- Page Wrapper -->
        <div id="wrapper">

            <!-- Sidebar -->
            <%- include('../layouts/sidebar.ejs') %>
                <!-- End of Sidebar -->

                <!-- Content Wrapper -->
                <div id="content-wrapper" class="d-flex flex-column">

                    <!-- Main Content -->
                    <div id="content">

                        <!-- Topbar -->
                        <%- include('../layouts/topbar.ejs') %>
                            <!-- End of Topbar -->

                            <!-- Begin Page Content -->
                            <div class="container-fluid">

                                <!-- Page Heading -->
                                <div class="d-sm-flex align-items-center justify-content-between mb-4">
                                    <h1 class="h3 mb-0 text-gray-800">Manage Cars</h1>
                                </div>

                                <!-- Content Row -->

                                <!-- Content Row -->
                                <div class="row">

                                    <div class="col-lg-12 mb-4">

                                        <!-- Illustrations -->
                                        <div class="card shadow mb-4">
                                            <div class="card-header py-3">
                                                <a href="/add-car-page" class="btn btn-lg btn-primary">
                                                    Add Car
                                                </a>
                                            </div>
                                            <div class="card-body">
                                               <div class="table-responsive">
                                                <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                                                    <thead>
                                                        <tr>
                                                            <th class="text-center">SL No.</th>
                                                            <th class="text-center">Image</th>
                                                            <th class="text-center">Brand</th>
                                                            <th class="text-center">Model</th>
                                                            <th class="text-center">Type</th>
                                                            <th class="text-center">FuelType</th>
                                                            <th class="text-center">Transmission</th>
                                                            <th class="text-center">Price</th>
                                                            <th class="text-center">Availability</th>
                                                            <th class="text-center">Action</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>

                                                        <% if(data.length> 0) { %>

                                                        <% data.forEach((car, index) => { %>
                                                            <tr>
                                                                <!-- SERIAL NUMBER -->
                                                                <td class="text-center">
                                                                    <%= index + 1 %>
                                                                </td>

                                                                <td class="text-center">
                                                                    <img src="<%= car.image %>" width="100%" height="70" style="object-fit: cover;">
                                                                </td>
                                                                <td class="text-center">
                                                                    <%= car.brand %>
                                                                </td>
                                                                <td class="text-center">
                                                                    <%= car.model %>
                                                                </td>
                                                                <td class="text-center">
                                                                    <%= car.type %>
                                                                </td>
                                                                <td class="text-center">
                                                                    <%= car.fuelType %>
                                                                </td class="text-center">
                                                                <td class="text-center">
                                                                    <%= car.transmission %>
                                                                </td>
                                                                <td class="text-center">
                                                                    ₹<%= car.pricePerDay %>
                                                                </td>

                                                                <td class="text-center">
                                                                <% if(car.availability) { %>

                                                                    <span class="badge badge-success">
                                                                        Available
                                                                    </span>

                                                                    <% } else { %>

                                                                        <span class="badge badge-danger">
                                                                            Not Available
                                                                        </span>

                                                                    <% } %>
                                                                </td>

                                                                <td class="text-center">

                                                                    <a href="/change-availability/<%= car._id %>" class="btn btn-primary btn-lg">

                                                                        <% if(car.availability) { %>

                                                                            Disable Car

                                                                            <% } else { %>

                                                                                Enable Car

                                                                            <% } %>

                                                                    </a>

                                                                    <a href="/view-car/<%= car._id %>" class="btn btn-info btn-lg mx-2">
                                                                        View Car
                                                                    </a>

                                                                    <a href="/edit-car/<%= car._id %>" class="btn btn-warning btn-lg mx-2">
                                                                        Edit Car
                                                                    </a>

                                                                    <a href="/delete-car/<%= car._id %>" class="btn btn-danger btn-lg mx-2"
                                                                        onclick="return confirm('Delete this car?')">
                                                                        Delete Car
                                                                    </a>

                                                                </td>

                                                            </tr>
                                                        <% }) %>
                                                        <% } else { %>

                                                            <tr>

                                                                <td colspan="8" class="text-center">

                                                                    No Cars Found

                                                                </td>

                                                            </tr>

                                                            <% } %>
                                                    </tbody>
                                                </table>
                                               </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!-- /.container-fluid -->
                    </div>
                    <!-- End of Main Content -->

                    <!-- Footer -->
                    <footer class="sticky-footer bg-white">
                        <div class="container my-auto">
                            <div class="copyright text-center my-auto">
                                <span>Copyright &copy; Your Website 2020</span>
                            </div>
                        </div>
                    </footer>
                    <!-- End of Footer -->

                </div>
                <!-- End of Content Wrapper -->

        </div>
        <!-- End of Page Wrapper -->

        <!-- Scroll to Top Button-->
        <a class="scroll-to-top rounded" href="#page-top">
            <i class="fas fa-angle-up"></i>
        </a>



        <%- include('../layouts/footer.ejs') %>