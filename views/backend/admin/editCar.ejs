<%- include('../layouts/header.ejs') %>

    <body id="page-top">

        <!-- Page Wrapper -->
        <div id="wrapper">

            <!-- Sidebar -->
            <%- include('../layouts/sidebar.ejs') %>
                <!-- End of Sidebar -->

                <!-- Content Wrapper -->
                <div id="content-wrapper" class="d-flex flex-column">

                    <!-- Main Content -->
                    <div id="content">

                        <!-- Topbar -->
                        <%- include('../layouts/topbar.ejs') %>
                            <!-- End of Topbar -->

                            <!-- Begin Page Content -->
                            <div class="container-fluid">

                                <!-- Page Heading -->
                                <div class="d-sm-flex align-items-center justify-content-between mb-4">
                                    <h1 class="h3 mb-0 text-gray-800">Edit Car Details</h1>
                                </div>

                                <!-- Content Row -->

                                <!-- Content Row -->
                                <div class="row">

                                    <div class="col-lg-12 mb-4">

                                        <!-- Illustrations -->
                                        <div class="card shadow mb-4">
                                            <div class="card-header py-3">
                                                <h6 class="m-0 font-weight-bold text-primary">Edit Profile</h6>
                                            </div>
                                            <div class="card-body">
                                                <%- include('../layouts/flash.ejs') %>

                                                    <form method="post" action="/update-car/<%= data._id %>" enctype="multipart/form-data">

                                                        <!-- BRAND -->
                                                        <div class="form-group mb-3">

                                                            <label>Brand</label>

                                                            <input type="text" name="brand" class="form-control" value="<%= data.brand %>" required>

                                                        </div>

                                                        <!-- MODEL -->
                                                        <div class="form-group mb-3">

                                                            <label>Model</label>

                                                            <input type="text" name="model" class="form-control" value="<%= data.model %>" required>

                                                        </div>

                                                        <!-- TYPE -->
                                                        <div class="form-group mb-3">

                                                            <label>data Type</label>

                                                            <select name="type" class="form-control" required>

                                                                <option value="SUV" <%=data.type==="SUV" ? "selected" : "" %>>
                                                                    SUV
                                                                </option>

                                                                <option value="Sedan" <%=data.type==="Sedan" ? "selected" : "" %>>
                                                                    Sedan
                                                                </option>

                                                                <option value="Hatchback" <%=data.type==="Hatchback" ? "selected" : "" %>>
                                                                    Hatchback
                                                                </option>

                                                                <option value="Luxury" <%=data.type==="Luxury" ? "selected" : "" %>>
                                                                    Luxury
                                                                </option>

                                                                <option value="Electric" <%=data.type==="Electric" ? "selected" : "" %>>
                                                                    Electric
                                                                </option>

                                                            </select>

                                                        </div>

                                                        <!-- FUEL TYPE -->
                                                        <div class="form-group mb-3">

                                                            <label>Fuel Type</label>

                                                            <select name="fuelType" class="form-control" required>

                                                                <option value="Petrol" <%=data.fuelType==="Petrol" ? "selected" : "" %>>
                                                                    Petrol
                                                                </option>

                                                                <option value="Diesel" <%=data.fuelType==="Diesel" ? "selected" : "" %>>
                                                                    Diesel
                                                                </option>

                                                                <option value="Electric" <%=data.fuelType==="Electric" ? "selected" : "" %>>
                                                                    Electric
                                                                </option>

                                                                <option value="Hybrid" <%=data.fuelType==="Hybrid" ? "selected" : "" %>>
                                                                    Hybrid
                                                                </option>

                                                            </select>

                                                        </div>

                                                        <!-- TRANSMISSION -->
                                                        <div class="form-group mb-3">

                                                            <label>Transmission</label>

                                                            <select name="transmission" class="form-control" required>

                                                                <option value="Manual" <%=data.transmission==="Manual" ? "selected" : "" %>>
                                                                    Manual
                                                                </option>

                                                                <option value="Automatic" <%=data.transmission==="Automatic" ? "selected" : "" %>>
                                                                    Automatic
                                                                </option>

                                                            </select>

                                                        </div>

                                                        <!-- PRICE -->
                                                        <div class="form-group mb-3">

                                                            <label>Price Per Day</label>

                                                            <input type="number" name="pricePerDay" class="form-control" value="<%= data.pricePerDay %>" required>

                                                        </div>

                                                        <!-- LOCATION -->
                                                        <div class="form-group mb-3">

                                                            <label>Location</label>

                                                            <input type="text" name="location" class="form-control" value="<%= data.location %>" required>

                                                        </div>

                                                        <!-- AVAILABILITY -->
                                                        <div class="form-group mb-3">

                                                            <label>Availability</label>

                                                            <select name="availability" class="form-control">

                                                                <option value="true" <%=data.availability ? "selected" : "" %>>
                                                                    Available
                                                                </option>

                                                                <option value="false" <%=!data.availability ? "selected" : "" %>>
                                                                    Not Available
                                                                </option>

                                                            </select>

                                                        </div>

                                                        <!-- CURRENT IMAGE -->
                                                        <div class="form-group mb-3">

                                                            <label>Current Image</label>

                                                            <br>

                                                            <img src="<%= data.image %>" width="auto" class="rounded shadow img-fluid">

                                                        </div>

                                                        <!-- NEW IMAGE -->
                                                        <div class="form-group mb-4">

                                                            <label>Upload New Image</label>

                                                            <input type="file" name="image" class="form-control">

                                                        </div>

                                                        <!-- BUTTONS -->
                                                        <button type="submit" class="btn btn-warning btn-lg">
                                                            Update Car
                                                        </button>

                                                        <a href="/manage-cars" class="btn btn-secondary btn-lg">
                                                            Cancel
                                                        </a>

                                                    </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!-- /.container-fluid -->
                    </div>
                    <!-- End of Main Content -->

                    <!-- Footer -->
                    <footer class="sticky-footer bg-white">
                        <div class="container my-auto">
                            <div class="copyright text-center my-auto">
                                <span>Copyright &copy; Your Website 2020</span>
                            </div>
                        </div>
                    </footer>
                    <!-- End of Footer -->

                </div>
                <!-- End of Content Wrapper -->

        </div>
        <!-- End of Page Wrapper -->

        <!-- Scroll to Top Button-->
        <a class="scroll-to-top rounded" href="#page-top">
            <i class="fas fa-angle-up"></i>
        </a>



        <%- include('../layouts/footer.ejs') %>